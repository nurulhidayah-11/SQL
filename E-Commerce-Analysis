SELECT
    customer_id,
    COUNT(*) AS jumlah
FROM Customers
GROUP BY customer_id
HAVING COUNT(*) > 1;

-- Analisa Customer dengan Spanding Tertinggi
SELECT
    c.customer_id,
    c.name,
    c.city,
    c.province,
    COUNT(DISTINCT o.order_id) AS total_orders,
    SUM(o.total_amount_idr) AS total_spending
FROM Customers c
JOIN Orders o
    ON c.customer_id = o.customer_id
WHERE o.order_status = 'Completed'
GROUP BY
    c.customer_id,
    c.name,
    c.city,
    c.province
ORDER BY total_spending DESC;

-- Top 10 Spanding Tertinggi
SELECT
    c.customer_id,
    c.name,
    COUNT(DISTINCT o.order_id) AS total_orders,
    SUM(o.total_amount_idr) AS total_spending
FROM Customers c
JOIN Orders o
    ON c.customer_id = o.customer_id
WHERE o.order_status = 'Completed'
GROUP BY
    c.customer_id,
    c.name
ORDER BY total_spending DESC
LIMIT 10;

--Produk Terbanyak Terjual
SELECT
    p.product_id,
    p.name AS product_name,
    p.category,
    SUM(oi.quantity) AS total_quantity_sold,
    SUM(oi.sub_total_idr) AS total_revenue
FROM Order_Items oi
JOIN Products p
    ON oi.product_id = p.product_id
JOIN Orders o
    ON oi.order_id = o.order_id
WHERE o.order_status = 'Completed'
GROUP BY
    p.product_id,
    p.name,
    p.category
ORDER BY total_quantity_sold DESC;

